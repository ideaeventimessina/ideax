{
 "openapi": "3.0.3",
 "info": {
  "title": "ideax API",
  "version": "0.0.0",
  "description": "API locale di ideax: genera e modifica immagini, video e animazioni con i modelli sul tuo PC.\n\nAutenticazione: dallo stesso PC non serve. Dagli altri dispositivi serve una chiave API (ideax → Collega app) in `Authorization: Bearer <chiave>`, oppure `X-API-Key`, oppure `?key=` per scaricare i file.\n\nWebhook: ideax invia POST JSON `{event, created, data}` con `X-Ideax-Signature: sha256=<HMAC-SHA256 del corpo con il segreto dei webhook>`. Eventi: job.completed, job.failed, job.cancelled, ping."
 },
 "security": [
  {
   "bearer": []
  },
  {
   "apiKey": []
  }
 ],
 "paths": {
  "/v1/generate": {
   "post": {
    "summary": "Crea un lavoro",
    "description": "JSON oppure multipart/form-data (campi come nel JSON, file in qualsiasi campo; params e metadata come stringhe JSON).",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/GenerateRequest"
       }
      },
      "multipart/form-data": {
       "schema": {
        "type": "object",
        "properties": {
         "prompt": {
          "type": "string"
         },
         "task": {
          "type": "string"
         },
         "model": {
          "type": "string"
         },
         "params": {
          "type": "string"
         },
         "metadata": {
          "type": "string"
         },
         "callback_url": {
          "type": "string"
         },
         "wait": {
          "type": "string"
         },
         "inline": {
          "type": "string"
         },
         "files": {
          "type": "array",
          "items": {
           "type": "string",
           "format": "binary"
          }
         }
        },
        "required": [
         "prompt"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Lavoro finito",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Job"
        }
       }
      }
     },
     "202": {
      "description": "Lavoro accettato (wait=false o webhook)",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "id": {
           "type": "string"
          },
          "status": {
           "type": "string"
          },
          "status_url": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/Error"
     },
     "401": {
      "$ref": "#/components/responses/Error"
     },
     "500": {
      "description": "Lavoro fallito",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Job"
        }
       }
      }
     }
    }
   }
  },
  "/v1/jobs/{id}": {
   "get": {
    "summary": "Stato e risultati di un lavoro",
    "parameters": [
     {
      "$ref": "#/components/parameters/Id"
     }
    ],
    "responses": {
     "200": {
      "description": "Lavoro",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Job"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/v1/jobs/{id}/cancel": {
   "post": {
    "summary": "Annulla un lavoro",
    "parameters": [
     {
      "$ref": "#/components/parameters/Id"
     }
    ],
    "responses": {
     "200": {
      "description": "Richiesta di annullamento inviata"
     }
    }
   }
  },
  "/v1/creations": {
   "get": {
    "summary": "Archivio delle creazioni",
    "parameters": [
     {
      "name": "type",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "image",
        "video",
        "animation",
        "audio"
       ]
      }
     },
     {
      "name": "q",
      "in": "query",
      "schema": {
       "type": "string"
      },
      "description": "Cerca nel titolo e nel prompt"
     },
     {
      "name": "limit",
      "in": "query",
      "schema": {
       "type": "integer",
       "default": 50,
       "maximum": 200
      }
     },
     {
      "name": "offset",
      "in": "query",
      "schema": {
       "type": "integer",
       "default": 0
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Elenco",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "total": {
           "type": "integer"
          },
          "limit": {
           "type": "integer"
          },
          "offset": {
           "type": "integer"
          },
          "items": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Creation"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/v1/creations/{id}": {
   "get": {
    "summary": "Una creazione",
    "parameters": [
     {
      "$ref": "#/components/parameters/Id"
     },
     {
      "name": "inline",
      "in": "query",
      "schema": {
       "type": "boolean"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Creazione",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Creation"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/Error"
     }
    }
   },
   "delete": {
    "summary": "Elimina una creazione e i suoi file",
    "parameters": [
     {
      "$ref": "#/components/parameters/Id"
     }
    ],
    "responses": {
     "200": {
      "description": "Eliminata"
     },
     "404": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/v1/models": {
   "get": {
    "summary": "Modelli disponibili e compiti",
    "responses": {
     "200": {
      "description": "Modelli",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "models": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "id": {
              "type": "string"
             },
             "name": {
              "type": "string"
             },
             "arch": {
              "type": "string"
             },
             "capabilities": {
              "type": "array",
              "items": {
               "type": "string",
               "enum": [
                "image_generate",
                "image_edit",
                "image_to_video",
                "video_generate",
                "video_edit",
                "animation"
               ]
              }
             },
             "description": {
              "type": "string"
             },
             "priority": {
              "type": "integer"
             }
            }
           }
          },
          "tasks": {
           "type": "object"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/v1/health": {
   "get": {
    "summary": "Stato del servizio (senza autenticazione)",
    "security": [],
    "responses": {
     "200": {
      "description": "Stato",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "status": {
           "type": "string",
           "enum": [
            "ok",
            "degraded"
           ]
          },
          "version": {
           "type": "string"
          },
          "worker": {
           "type": "string",
           "enum": [
            "online",
            "offline"
           ]
          },
          "queue": {
           "type": "object",
           "properties": {
            "active": {
             "type": "integer"
            },
            "waiting": {
             "type": "integer"
            }
           }
          },
          "models": {
           "type": "integer"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/v1/images/generations": {
   "post": {
    "summary": "Compatibile OpenAI: genera immagini",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "prompt"
        ],
        "properties": {
         "prompt": {
          "type": "string"
         },
         "model": {
          "type": "string"
         },
         "n": {
          "type": "integer"
         },
         "size": {
          "type": "string",
          "example": "1024x1024"
         },
         "response_format": {
          "type": "string",
          "enum": [
           "url",
           "b64_json"
          ]
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Formato OpenAI"
     }
    }
   }
  },
  "/v1/openapi.json": {
   "get": {
    "summary": "Questa specifica",
    "security": [],
    "responses": {
     "200": {
      "description": "OpenAPI 3"
     }
    }
   }
  },
  "/v1/voices": {
   "get": {
    "summary": "Voci clonate",
    "responses": {
     "200": {
      "description": "Elenco",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "voices": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Voice"
           }
          },
          "engine": {
           "type": "string",
           "enum": [
            "installed",
            "missing"
           ]
          }
         }
        }
       }
      }
     }
    }
   },
   "post": {
    "summary": "Crea una voce clonata da un campione audio (10–30 s)",
    "description": "Serve il consenso della persona: consent=true. Il campione può essere wav, mp3, m4a, webm…",
    "requestBody": {
     "required": true,
     "content": {
      "multipart/form-data": {
       "schema": {
        "type": "object",
        "required": [
         "name",
         "consent",
         "file"
        ],
        "properties": {
         "name": {
          "type": "string"
         },
         "language": {
          "type": "string",
          "default": "it"
         },
         "consent": {
          "type": "string",
          "enum": [
           "true"
          ]
         },
         "consent_by": {
          "type": "string"
         },
         "file": {
          "type": "string",
          "format": "binary"
         }
        }
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Voce creata",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Voice"
        }
       }
      }
     },
     "400": {
      "$ref": "#/components/responses/Error"
     },
     "409": {
      "description": "Motore voce non installato"
     }
    }
   }
  },
  "/v1/voices/{id}": {
   "patch": {
    "summary": "Rinomina o imposta i valori predefiniti di una voce",
    "parameters": [
     {
      "$ref": "#/components/parameters/Id"
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "name": {
          "type": "string"
         },
         "language": {
          "type": "string"
         },
         "defaults": {
          "type": "object",
          "example": {
           "exaggeration": 0.6,
           "cfg_weight": 0.4
          }
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Aggiornata"
     }
    }
   },
   "delete": {
    "summary": "Elimina una voce e il suo campione",
    "parameters": [
     {
      "$ref": "#/components/parameters/Id"
     }
    ],
    "responses": {
     "200": {
      "description": "Eliminata"
     }
    }
   }
  },
  "/v1/voices/{id}/sample": {
   "get": {
    "summary": "Campione della voce (WAV)",
    "parameters": [
     {
      "$ref": "#/components/parameters/Id"
     }
    ],
    "responses": {
     "200": {
      "description": "audio/wav"
     }
    }
   }
  },
  "/v1/speech": {
   "post": {
    "summary": "Legge un testo con una voce clonata",
    "description": "Stesse opzioni dei lavori: wait, callback_url, metadata, inline. Il risultato è un MP3 (o WAV) in results[0].",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "text"
        ],
        "properties": {
         "text": {
          "type": "string",
          "example": "Ciao a tutti! Oggi vi presento il nostro nuovo prodotto."
         },
         "voice": {
          "type": "string",
          "description": "Id o nome della voce. Se manca, la più recente"
         },
         "language": {
          "type": "string",
          "description": "Se manca, quella della voce"
         },
         "format": {
          "type": "string",
          "enum": [
           "mp3",
           "wav"
          ],
          "default": "mp3"
         },
         "exaggeration": {
          "type": "number",
          "default": 0.5,
          "description": "Espressività: 0.25 pacata, 0.5 naturale, 0.8+ teatrale"
         },
         "cfg_weight": {
          "type": "number",
          "default": 0.5,
          "description": "Ritmo: più basso = più lento e calmo"
         },
         "temperature": {
          "type": "number",
          "default": 0.8
         },
         "seed": {
          "type": "integer"
         },
         "pause_ms": {
          "type": "integer",
          "default": 180,
          "description": "Pausa tra le frasi"
         },
         "wait": {
          "type": "boolean",
          "default": true
         },
         "callback_url": {
          "type": "string"
         },
         "metadata": {
          "type": "object"
         },
         "inline": {
          "type": "boolean"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Audio pronto",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Job"
        }
       }
      }
     },
     "202": {
      "description": "Accettato (wait=false o webhook)"
     }
    }
   }
  },
  "/v1/audio/speech": {
   "post": {
    "summary": "Compatibile OpenAI TTS: restituisce direttamente l'audio",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "input"
        ],
        "properties": {
         "model": {
          "type": "string"
         },
         "input": {
          "type": "string"
         },
         "voice": {
          "type": "string",
          "description": "Nome della voce clonata in ideax"
         },
         "response_format": {
          "type": "string",
          "enum": [
           "mp3",
           "wav"
          ]
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "audio/mpeg o audio/wav"
     }
    }
   }
  },
  "/v1/music": {
   "post": {
    "summary": "Compone musica: basi, sottofondi, jingle, canzoni (ACE-Step 1.5)",
    "description": "Stesse opzioni dei lavori: wait, callback_url, metadata, inline. Il brano è in results[0], con metas (bpm, tonalità, durata).",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "prompt"
        ],
        "properties": {
         "prompt": {
          "type": "string",
          "example": "Lo-fi rilassata con pianoforte e batteria morbida, 80 BPM, sottofondo per un reel"
         },
         "duration": {
          "type": "number",
          "default": 30,
          "description": "Secondi, da 10 a 600"
         },
         "instrumental": {
          "type": "boolean",
          "default": true,
          "description": "false = canzone: con lyrics usa il tuo testo, senza lo scrive il motore"
         },
         "lyrics": {
          "type": "string",
          "description": "Testo della canzone, con [verse], [chorus]…"
         },
         "language": {
          "type": "string",
          "default": "it",
          "description": "Lingua del canto"
         },
         "bpm": {
          "type": "integer"
         },
         "key": {
          "type": "string",
          "example": "A Minor"
         },
         "seed": {
          "type": "integer"
         },
         "quality": {
          "type": "string",
          "enum": [
           "high",
           "fast"
          ],
          "default": "high"
         },
         "format": {
          "type": "string",
          "enum": [
           "mp3",
           "wav"
          ],
          "default": "mp3"
         },
         "wait": {
          "type": "boolean",
          "default": true
         },
         "callback_url": {
          "type": "string"
         },
         "metadata": {
          "type": "object"
         },
         "inline": {
          "type": "boolean"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Brano pronto",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Job"
        }
       }
      }
     },
     "202": {
      "description": "Accettato (wait=false o webhook)"
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer",
    "description": "Chiave API ideax_sk_…"
   },
   "apiKey": {
    "type": "apiKey",
    "in": "header",
    "name": "X-API-Key"
   }
  },
  "parameters": {
   "Id": {
    "name": "id",
    "in": "path",
    "required": true,
    "schema": {
     "type": "string"
    }
   }
  },
  "responses": {
   "Error": {
    "description": "Errore",
    "content": {
     "application/json": {
      "schema": {
       "type": "object",
       "properties": {
        "error": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  },
  "schemas": {
   "Result": {
    "type": "object",
    "properties": {
     "url": {
      "type": "string",
      "description": "Indirizzo del file"
     },
     "type": {
      "type": "string",
      "example": "image/png"
     },
     "data": {
      "type": "string",
      "description": "Contenuto in base64, solo con inline"
     }
    }
   },
   "Job": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "example": "a1b2c3d4"
     },
     "status": {
      "type": "string",
      "enum": [
       "queued",
       "routing",
       "running",
       "done",
       "error",
       "cancelled"
      ]
     },
     "waiting": {
      "type": "boolean",
      "description": "In fila: la GPU sta finendo un altro lavoro"
     },
     "progress": {
      "type": "object",
      "nullable": true,
      "properties": {
       "step": {
        "type": "integer"
       },
       "total": {
        "type": "integer"
       },
       "phase": {
        "type": "string"
       }
      }
     },
     "title": {
      "type": "string"
     },
     "prompt": {
      "type": "string"
     },
     "task": {
      "type": "string",
      "enum": [
       "image_generate",
       "image_edit",
       "image_to_video",
       "video_generate",
       "video_edit",
       "animation"
      ]
     },
     "model": {
      "type": "string"
     },
     "routedPrompt": {
      "type": "string",
      "description": "Prompt effettivamente inviato al modello"
     },
     "negativePrompt": {
      "type": "string"
     },
     "loras": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "reason": {
      "type": "string"
     },
     "error": {
      "type": "string"
     },
     "client": {
      "type": "string",
      "description": "Nome della chiave API che ha creato il lavoro"
     },
     "metadata": {
      "type": "object",
      "description": "Restituito tale e quale: utile per collegare il lavoro ai vostri dati"
     },
     "results": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/Result"
      }
     },
     "createdAt": {
      "type": "integer"
     },
     "finishedAt": {
      "type": "integer"
     },
     "seconds": {
      "type": "integer",
      "nullable": true
     }
    }
   },
   "GenerateRequest": {
    "type": "object",
    "required": [
     "prompt"
    ],
    "properties": {
     "prompt": {
      "type": "string",
      "example": "Un faro sulla scogliera al tramonto, stile acquerello"
     },
     "task": {
      "type": "string",
      "enum": [
       "image_generate",
       "image_edit",
       "image_to_video",
       "video_generate",
       "video_edit",
       "animation"
      ],
      "description": "Facoltativo: se manca lo decide ideax dal prompt e dagli allegati"
     },
     "model": {
      "type": "string",
      "description": "Id o nome di un modello (GET /v1/models). Se manca lo sceglie ideax"
     },
     "params": {
      "type": "object",
      "description": "Parametri per il modello",
      "example": {
       "aspect": "16:9",
       "seed": 42,
       "num_inference_steps": 30
      }
     },
     "attachments": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "url": {
         "type": "string"
        },
        "dataUrl": {
         "type": "string"
        },
        "base64": {
         "type": "string"
        },
        "type": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       }
      },
      "description": "Immagini o video da modificare/animare"
     },
     "wait": {
      "type": "boolean",
      "default": true,
