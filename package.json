{
  "name": "ideax",
  "version": "1.27.20",
  "description": "Gateway locale per modelli AI di immagini, video e animazioni: drag & drop dei modelli, instradamento automatico dei prompt, API unica per tutte le app",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "worker": "python worker/server.py",
    "build:exe": "node build/build-exe.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^2.0.0"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "acorn": "8.15.0",
    "quickjs-emscripten-core": "0.32.0"
  }
}
